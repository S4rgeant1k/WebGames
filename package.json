{
  "name": "webgames-pc-build-sim",
  "version": "1.0.0",
  "private": true,
  "description": "Браузерный 3D-симулятор сборки ПК",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2020 --outfile=assets/game.js",
    "watch": "esbuild src/main.js --bundle --format=esm --target=es2020 --outfile=assets/game.js --watch",
    "test": "node --test tests/logic.test.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
